{
  "Team worker skills": {
    "scope": "chatagent",
    "prefix": "skills",
    "body": "skills: [${1:skill-id}]",
    "description": "Assign reusable skills to this worker."
  },
  "Team worker reasoning effort": {
    "scope": "chatagent",
    "prefix": "reasoning-effort",
    "body": "reasoning-effort: ${1|low,medium,high,xhigh,max|}",
    "description": "Set the worker reasoning effort."
  },
  "Team workflow phases": {
    "scope": "prompt",
    "prefix": "phases",
    "body": [
      "phases:",
      "  - id: ${1:phase-id}",
      "    workers: [${2:worker-id}]"
    ],
    "description": "Declare ordered workflow phases."
  }
}
